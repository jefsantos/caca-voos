# ============ SerpAPI (obrigatório) ============
# Crie a conta gratuita em https://serpapi.com (100 buscas/mês no plano free)
SERPAPI_KEY=sua_api_key_da_serpapi

# ============ Parâmetros da busca ============
ORIGIN=GRU
DESTINATIONS=FCO,MXP,VCE
DEPARTURE_START=2026-09-08
DEPARTURE_END=2026-09-12
STAY_DAYS=5,6
CURRENCY=BRL
# Buscas por execução — 3/dia = ~90/mês, dentro da cota gratuita.
# As 30 combinações são cobertas em rodízio (todas a cada 10 dias).
SEARCHES_PER_RUN=3

# ============ Alerta ============
# Notifica quando o total ida+volta ficar igual ou abaixo desse valor
PRICE_CEILING=4500

# ============ E-mail (opcional — Gmail: use senha de app) ============
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASSWORD=sua_senha_de_app
EMAIL_TO=seuemail@gmail.com

# ============ WhatsApp via Evolution API (opcional) ============
EVOLUTION_BASE_URL=https://sua-evolution.exemplo.com
EVOLUTION_API_KEY=sua_apikey
EVOLUTION_INSTANCE=minha_instancia
# Formato: DDI+DDD+numero, ex.: 5511999999999
WHATSAPP_NUMBER=5511999999999

# ============ Persistência ============
HISTORY_FILE=price_history.json

# ============ Dashboard (GitHub Pages) ============
DASHBOARD_DATA_FILE=docs/data.json
# URL do painel — entra como link no e-mail/WhatsApp de alerta
# Formato: https://SEU_USUARIO.github.io/NOME_DO_REPO/
DASHBOARD_URL=https://seuusuario.github.io/caca-voos-agente/
